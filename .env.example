# ОБРАЗЕЦ. Скопируй в .env и заполни (см. README, шаг 2).
# Секреты панели. Не коммитить.
DJANGO_SECRET_KEY=
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
# Служебный токен, по которому бот ходит в API (тот же вписать в .env бота)
BOT_API_TOKEN=
# Ключ шифрования секретов в базе
SECRETS_KEY=
# Чат Telegram для уведомлений сотрудникам (id группы, начинается с -100)
STAFF_CHAT_ID=
